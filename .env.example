# Copy to .env (gitignored). Placeholders only: never commit real values.
SOLANA_CLUSTER=surfpool
SOLANA_RPC_HTTP_URL=http://127.0.0.1:8899
SOLANA_RPC_WS_URL=ws://127.0.0.1:8900
SOLANA_FALLBACK_RPC_HTTP_URL=
SOLANA_COMMITMENT=confirmed
# Public program id from Anchor.toml (the program keypair lives in .keys/, never here).
MANDATE_PROGRAM_ID=T2GzQeoAYprQyUorm7r6jaRvmoPhtXuZ6vJYYBS1pzc
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
LOG_LEVEL=info
# Never use the shared public mainnet RPC when SOLANA_CLUSTER=mainnet-beta (config rejects it).
# Observer leader/replay timing (ADR 0015). (observer count - 1) * TIMEOUT must be smaller than LEAD.
OBSERVER_OBSERVE_LEAD_SECONDS=60
OBSERVER_LEADER_TIMEOUT_SECONDS=15
# Read plane (ADR 0018). Services also read their own apps/*/.env.example.
DATABASE_URL=postgresql://mandate:mandate@127.0.0.1:5432/mandate
RATE_LIMIT_PER_MINUTE=120
API_MAX_STALENESS_SECONDS=120
# Optional: run the suite against a real PostgreSQL (throwaway databases are created and dropped).
# TEST_DATABASE_URL=postgresql://localhost:5432/postgres
