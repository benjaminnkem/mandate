{
  "name": "@mandate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mandate public read API",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --hookTimeout=30000",
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test:load": "LOAD_MANDATES=${LOAD_MANDATES:-3000} vitest run test/load.test.ts --disable-console-intercept"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "11.2.0",
    "@mandate/config": "workspace:*",
    "@mandate/db": "workspace:*",
    "@mandate/domain": "workspace:*",
    "@mandate/observability": "workspace:*",
    "@mandate/prestocks": "workspace:*",
    "@mandate/solana": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mandate/testkit": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.2",
    "bn.js": "5.2.5",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
