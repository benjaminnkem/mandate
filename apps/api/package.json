{
  "name": "@mandate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mandate public read API",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@mandate/config": "workspace:*",
    "@mandate/observability": "workspace:*",
    "@mandate/prestocks": "workspace:*",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
