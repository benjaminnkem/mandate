# One file per instance, e.g. apps/observer/.env.observer1 (gitignored).
OBSERVER_INSTANCE_ID=observer-1
OBSERVER_KEYPAIR_PATH=.keys/observer-1.json
# Must equal the pubkey of the keypair above; the observer checks this at startup.
OBSERVER_EXPECTED_PUBKEY=
EVIDENCE_STORAGE_MODE=filesystem
EVIDENCE_STORAGE_PATH=./evidence-store
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
MEASUREMENT_ALGORITHM_VERSION=1
DATABASE_URL=
