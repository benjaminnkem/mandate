{
  "name": "mandate",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yml}\"",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "program:build": "cargo build-sbf --manifest-path programs/mandate/Cargo.toml && anchor idl build -o target/idl/mandate.json",
    "check": "pnpm format:check && pnpm vectors:check && pnpm lint && pnpm typecheck && pnpm test && pnpm rust:fmt && pnpm rust:lint && pnpm program:build && pnpm rust:test",
    "vectors:check": "python3 packages/domain/vectors/generate_golden.py --check",
    "vectors:generate": "python3 packages/domain/vectors/generate_golden.py",
    "inspect:prestocks": "pnpm --filter @mandate/scripts inspect:prestocks",
    "market:discover": "pnpm --filter @mandate/scripts market:discover",
    "market:measure": "pnpm --filter @mandate/scripts market:measure",
    "market:positions": "pnpm --filter @mandate/scripts market:positions"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
