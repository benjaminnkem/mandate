{
  "name": "@mandate/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL read-model schema and migrations (rebuildable from chain)",
  "exports": {
    ".": "./src/index.ts",
    "./pglite": "./src/pglite.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests --hookTimeout=30000",
    "migrate": "node src/migrate-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
